  "entities": [
    {
      "id": "actor",
      "name": "actor",
      "grain": "person",
      "fields": ["actor_key (salted pseudonym)", "org", "team / cost centre"]
    },
    {
      "id": "ai_session",
      "name": "ai_session",
      "grain": "one agent session",
      "fields": ["session_key = surface + native ID", "surface, client version", "agent name / type, mode", "repository, branch", "base / head commit", "parent session", "started_at, ended_at"]
    },
    {
      "id": "model_call",
      "name": "model_call",
      "grain": "one model API call",
      "fields": ["call_key", "session_key, agent instance", "initiator / interaction class", "model, auto, BYOK", "reasoning_effort", "input / output / cache-read / cache-write / reasoning tokens", "credits_nano_aiu (nullable) + credit source", "multiplier, duration, TTFT, finish reason"]
    },
    {
      "id": "tool_call",
      "name": "tool_call",
      "grain": "one tool call",
      "fields": ["tool_call_key", "class: built-in, MCP, skill, sub-agent, hook", "tool, MCP server (hash)", "success, duration"]
    },
    {
      "id": "work_item",
      "name": "work_item",
      "grain": "PR, issue, commit, branch, workflow run, task",
      "fields": ["provider, repository", "number / SHA / ref", "URL", "opened_at, merged_at, closed_at"]
    },
    {
      "id": "attribution",
      "name": "attribution",
      "grain": "session ↔ work item",
      "fields": ["tier (T0–T3)", "method, evidence", "confidence", "weight (≤ 1 per session)"]
    },
    {
      "id": "outcome",
      "name": "outcome",
      "grain": "measured result",
      "fields": ["kind", "value, unit", "source", "observed_at"]
    },
    {
      "id": "cost_ledger",
      "name": "cost_ledger",
      "grain": "billing line",
      "fields": ["day, user", "product, SKU, model", "net quantity, net amount", "reconciliation only"]
    }
  ],
  "relationships": [
    { "from": "actor", "to": "ai_session", "label": "starts" },
    { "from": "ai_session", "to": "model_call", "label": "contains" },
    { "from": "ai_session", "to": "tool_call", "label": "contains" },
    { "from": "ai_session", "to": "attribution", "label": "linked by" },
    { "from": "work_item", "to": "attribution", "label": "linked by" },
    { "from": "work_item", "to": "outcome", "label": "produces" },
    { "from": "ai_session", "to": "outcome", "label": "produces" },
    { "from": "cost_ledger", "to": "actor", "label": "billed to" }
  ],
  "tiers": [
    { "id": "T0", "name": "Native", "method": "ID emitted by the surface", "example": "Cloud agent session → PR; session_refs PR; audit agent_session_id", "confidence": "high" },
    { "id": "T1", "name": "Deterministic", "method": "Exact join on VCS keys", "example": "(repo, branch) → PR head ref; (repo, head commit) ∈ PR commits; app worktree branch → PR", "confidence": "high" },
    { "id": "T2", "name": "Inferred", "method": "Time and content overlap", "example": "Same repo and actor inside the PR commit window; modified files ∩ PR diff", "confidence": "medium" },
    { "id": "T3", "name": "Allocated", "method": "Proportional share", "example": "Org day/user/model credits distributed by attributed local share", "confidence": "low" },
    { "id": "U", "name": "Unattributed", "method": "Kept explicitly", "example": "Never dropped, so coverage stays visible", "confidence": "n/a" }
  ],
  "invariants": [
    "Count each model call once, by stable call ID; never add invoke_agent totals to chat calls.",
    "Never sum overlapping sources; use precedence or per-dimension max and record the source.",
    "Unknown is not zero; report credit coverage alongside credit totals.",
    "Credits = nano-AIU / 1,000,000,000; no token-to-currency estimate without an explicit, labelled rate.",
    "Attribution weights per session sum to at most 1; the remainder stays unattributed.",
    "Local observations are not a bill; reconcile against the billing usage API at day/user/model grain.",
    "No prompt or response content; pseudonymise actors; keep MCP names hashed unless governed.",
    "Never present credits, cache ratios or PR references as monetary ROI or proof of value; report cost, outcome and baseline coverage separately."
  ],
  "outcomes": [
    { "id": "coverage", "name": "PR-reference coverage", "measure": "% of reported credits in sessions with a repository, branch and recorded PR reference; not verified delivery or value", "availability": "local", "liveMetric": "creditsToPrShare" },
    { "id": "repo_coverage", "name": "Work-context coverage", "measure": "% of credits in sessions with a repository", "availability": "local", "liveMetric": "creditsToRepoShare" },
    { "id": "credit_coverage", "name": "Credit coverage", "measure": "% of model calls that report credits", "availability": "local", "liveMetric": "creditCoverage" },
    { "id": "cost_per_change", "name": "Cost per delivered change", "measure": "Credits per merged PR, per work-item type", "availability": "needs-vcs-join" },
    { "id": "ai_share", "name": "AI-assisted share", "measure": "% of merged PRs with T0/T1 attribution", "availability": "needs-vcs-join" },
    { "id": "efficiency", "name": "Cache-read share", "measure": "Cached input tokens / reported input tokens; a usage mix indicator, not time or money saved", "availability": "local", "liveMetric": "cacheReadRatio" },
    { "id": "speed", "name": "Speed", "measure": "PR lead time AI-assisted vs baseline; agent latency and TTFT", "availability": "needs-vcs-join" },
    { "id": "quality", "name": "Quality", "measure": "Edit acceptance, survival, review rounds, CI pass rate, revert rate, task completion", "availability": "needs-vcs-join" },
    { "id": "reconciliation", "name": "Billed AI cost", "measure": "Reconcile reported credits with billed net amount by user/day/model; include seat and infrastructure costs", "availability": "needs-org-api" },
    { "id": "human_effort", "name": "Human effort and rework", "measure": "Developer time spent prompting, reviewing, correcting and maintaining delivered work vs comparable non-AI work", "availability": "needs-baseline" },
