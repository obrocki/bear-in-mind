{
  "schemaVersion": 1,
  "title": "Measuring ROI on AI-assisted development",
  "updated": "2026-09-30",
  "workstream": "Data and Attribution Model",
  "question": "What does AI-assisted development cost, what value does it deliver, and can we credibly attribute the difference?",
  "summary": "ROI requires both the incremental cost of AI-assisted work and its incremental value against a comparable baseline. Local Copilot stores report consumption and some work context, not monetary cost, developer time saved or delivered value. The live measurements below show how much reported usage can be linked to work; they are ROI readiness indicators, not ROI. A deterministic PR join, verified delivery and quality outcomes, billing and human effort data, and a comparable baseline are needed before calculating a return.",
  "surfaces": [
    {
      "id": "vscode",
      "name": "VS Code",
      "detail": "Copilot Chat agents",
      "collection": "OTel (OTLP or JSON-lines file), local span DB agent-traces.db, chat transcripts (internal)",
      "sessionKey": "copilot_chat.chat_session_id / gen_ai.conversation.id",
      "liveSource": "traces"
    },
    {
      "id": "cli",
      "name": "Copilot CLI",
      "detail": "Terminal agent",
      "collection": "Session events → ~/.copilot/session-state/, SQLite session store, optional OTel export, cloud session sync",
      "sessionKey": "sessionId",
      "liveSource": "sessionStore"
    },
    {
      "id": "app",
      "name": "GitHub Copilot app",
      "detail": "Desktop sessions in worktrees",
      "collection": "Same agent runtime and session store as Copilot CLI; one app-managed branch per session",
      "sessionKey": "sessionId",
      "liveSource": "sessionStore"
    },
    {
      "id": "cloud",
      "name": "Copilot cloud agent",
      "detail": "Runs in GitHub Actions, opens PRs",
      "collection": "Session logs, Actions workflow runs, agentic audit log, session streaming (preview)",
      "sessionKey": "agent_session_id",
      "liveSource": null
    },
    {
      "id": "org",
      "name": "Organisation plane",
      "detail": "Usage metrics, billing, audit",
      "collection": "Copilot usage metrics REST/NDJSON, billing usage REST, seat management, audit log",
      "sessionKey": null,
      "liveSource": null
    }
  ],
  "availabilityLevels": [
    { "id": "native", "label": "Native", "description": "Emitted directly by the surface." },
    { "id": "partial", "label": "Partial", "description": "Emitted for some calls, at a coarser grain, hashed, or only in the UI." },
    { "id": "derived", "label": "Derived", "description": "Computable from other native fields on the same surface." },
    { "id": "missing", "label": "Missing", "description": "Not emitted; needs an external join." },
    { "id": "unverified", "label": "Unverified", "description": "Documented by secondary sources only." }
  ],
  "groups": [
    { "id": "identity", "label": "Identity" },
    { "id": "consumption", "label": "Consumption" },
    { "id": "tooling", "label": "Tooling" },
    { "id": "work", "label": "Work" },
    { "id": "outcome", "label": "Outcome" }
  ],
  "concepts": [
    {
      "id": "time",
      "name": "Time",
      "group": "identity",
      "canonical": "model_call.started_at",
      "otel": "span start / end",
      "surfaces": {
        "vscode": { "availability": "native", "field": "span start_time / end_time" },
        "cli": { "availability": "native", "field": "event timestamp" },
        "app": { "availability": "native", "field": "event timestamp" },
        "cloud": { "availability": "native", "field": "session log, audit @timestamp" },
        "org": { "availability": "partial", "field": "day", "note": "Daily grain only." }
      }
    },
    {
      "id": "surface",
      "name": "Surface / client",
      "group": "identity",
      "canonical": "ai_session.surface",
      "otel": "service.name",
      "surfaces": {
        "vscode": { "availability": "native", "field": "service.name = copilot-chat, gen_ai.agent.name" },
        "cli": { "availability": "native", "field": "session.start.producer, copilotVersion" },
        "app": { "availability": "partial", "field": "session.start.producer", "note": "Shares the CLI runtime; the session store does not mark app vs CLI sessions." },
        "cloud": { "availability": "native", "field": "actor_is_agent, commit author Copilot" },
        "org": { "availability": "native", "field": "used_* flags, report type" }
      }
    },
    {
      "id": "actor",
      "name": "Actor",
      "group": "identity",
      "canonical": "actor.actor_key",
      "otel": "none (no enduser.* by default)",
      "surfaces": {
        "vscode": { "availability": "missing", "field": "session.id is per window", "note": "No PII in default attributes." },
        "cli": { "availability": "missing", "field": "signed-in login not stored per row", "note": "A collector can add a salted pseudonym." },
        "app": { "availability": "missing", "field": "signed-in login not stored per row" },
        "cloud": { "availability": "native", "field": "audit user, commit co-author" },
        "org": { "availability": "native", "field": "user_login, user_id" }
